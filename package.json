{
  "name": "vizbrix",
  "version": "0.1.0",
  "description": "Free-placement dashboard layout engine for React. Pixel-precise placement that actually reflows.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "MysMon",
  "keywords": [
    "dashboard",
    "layout",
    "free-placement",
    "freeform",
    "drag-and-drop",
    "resize",
    "react",
    "typescript",
    "headless",
    "canvas"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MysMon/vizbrix.git"
  },
  "homepage": "https://github.com/MysMon/vizbrix#readme",
  "bugs": {
    "url": "https://github.com/MysMon/vizbrix/issues"
  },
  "files": [
    "dist",
    "README.ja.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      },
      "require": {
        "types": "./dist/schema.d.cts",
        "default": "./dist/schema.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./react/view": {
      "import": {
        "types": "./dist/react/view.d.ts",
        "default": "./dist/react/view.js"
      },
      "require": {
        "types": "./dist/react/view.d.cts",
        "default": "./dist/react/view.cjs"
      }
    },
    "./react/static": {
      "import": {
        "types": "./dist/react/static.d.ts",
        "default": "./dist/react/static.js"
      },
      "require": {
        "types": "./dist/react/static.d.cts",
        "default": "./dist/react/static.cjs"
      }
    },
    "./locales/ja": {
      "import": {
        "types": "./dist/locales/ja.d.ts",
        "default": "./dist/locales/ja.js"
      },
      "require": {
        "types": "./dist/locales/ja.d.cts",
        "default": "./dist/locales/ja.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^3.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.20.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vitest": "^3.0.5"
  }
}
