{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "vizbrix": ["../../src/core/index.ts"],
      "vizbrix/react": ["../../src/react/index.ts"],
      "vizbrix/react/static": ["../../src/react/static.ts"],
      "vizbrix/charts": ["../../src/charts/index.ts"],
      "vizbrix/bricks": ["../../src/bricks/index.tsx"],
      "vizbrix/echarts": ["../../src/echarts/index.ts"],
      "vizbrix/locales/ja": ["../../src/locales/ja.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
